          "datatype": "string",
          "multi": false,
          "required": true
        },
        "koch:activity": {
          "datatype": "string",
          "multi": false,
          "required": true,
          "source": "receive or send"
        },
        "koch:lesson": {
          "datatype": "uri",
          "multi": false,
          "required": true
        },
        "koch:lessonNumber": {
          "datatype": "integer",
          "multi": false,
          "required": true
        },
        "koch:accuracy": {
          "datatype": "double",
          "multi": false,
          "required": true
