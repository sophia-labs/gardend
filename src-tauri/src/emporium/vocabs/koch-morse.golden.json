          "required": true
        },
        "koch:performanceScore": {
          "datatype": "double",
          "multi": false,
          "required": true
        },
        "koch:timingScore": {
          "datatype": "double",
          "multi": false,
          "required": false
        },
        "koch:durationScore": {
          "datatype": "double",
          "multi": false,
          "required": false
        },
        "koch:spacingScore": {
          "datatype": "double",
          "multi": false,
          "required": false
        },
        "koch:consistencyScore": {
          "datatype": "double",
          "multi": false,
          "required": false
        },
        "koch:keyingTrace": {
          "datatype": "string",
          "multi": false,
          "required": false
        },
        "koch:legacySubject": {
          "datatype": "string",
