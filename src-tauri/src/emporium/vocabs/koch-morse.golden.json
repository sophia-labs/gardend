        "koch:hasAttempt": {
          "datatype": "uri",
          "multi": true,
          "required": false
        },
        "prov:used": {
          "datatype": "uri",
          "multi": false,
          "required": true
        },
        "prov:wasAssociatedWith": {
          "datatype": "uri",
          "multi": false,
          "required": true
        },
        "prov:endedAtTime": {
          "datatype": "dateTime",
          "multi": false,
          "required": true
        }
      },
      "public_jurisdiction": "koch",
      "rdf_types": [
        "koch:PracticeSession",
        "prov:Activity"
      ],
      "subject_rule": "{graph_subject}:projection:koch-morse:session:{localId}",
      "source_kind": "current-state",
      "identity_kind": "event-id",
      "store_mode": "materialize",
      "store_target": "projection:koch-morse",
      "enforcement": "halt",
      "reconciliation_strategy": "producerDirected",
      "dispatch_mode": "current-state-materialize"
    },
