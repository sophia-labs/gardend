{
  "classes": {
    "KochCourse": {
      "comment": "The graph-local root of the standard Koch curriculum. The curriculum face reads this Meaningful Object and follows its ordered lesson relations; the shell does not invent a Koch surface outside the graph.",
      "predicates": {
        "koch:courseId": {
          "datatype": "string",
          "multi": false,
          "required": true,
          "source": "stable course identifier"
        },
        "rdfs:label": {
          "datatype": "string",
          "multi": false,
          "required": true
        },
        "koch:sequenceVersion": {
          "datatype": "string",
          "multi": false,
          "required": true,
          "source": "the named character-order edition used to construct the lessons"
        },
        "koch:hasLesson": {
          "datatype": "uri",
          "multi": true,
          "required": true,
          "source": "the ordered lesson objects; order is recovered from koch:lessonNumber"
        }
      },
      "projection_faces": [
        "koch.curriculum.v1"
      ],
      "public_jurisdiction": "koch",
      "rdf_types": [
        "koch:KochCourse"
      ],
      "subject_rule": "{graph_subject}:projection:koch-morse:course:{localId}",
      "source_kind": "current-state",
      "identity_kind": "logical-id",
      "store_mode": "materialize",
      "store_target": "projection:koch-morse",
      "enforcement": "halt",
      "reconciliation_strategy": "codeBacked",
      "dispatch_mode": "current-state-materialize"
    },
    "MorseCharacter": {
      "comment": "One symbol in the graph-local Morse alphabet, including its audible dit-dah pattern and position in the course sequence.",
      "predicates": {
        "rdfs:label": {
          "datatype": "string",
          "multi": false,
          "required": true
        },
        "koch:symbol": {
          "datatype": "string",
          "multi": false,
          "required": true
        },
        "koch:morseCode": {
          "datatype": "string",
          "multi": false,
          "required": true
        },
        "koch:sequenceIndex": {
          "datatype": "integer",
          "multi": false,
          "required": true
        },
        "koch:inCourse": {
          "datatype": "uri",
          "multi": false,
          "required": true
        }
      },
      "public_jurisdiction": "koch",
      "rdf_types": [
        "koch:MorseCharacter"
      ],
      "subject_rule": "{graph_subject}:projection:koch-morse:character:{localId}",
      "source_kind": "current-state",
      "identity_kind": "logical-id",
      "store_mode": "materialize",
      "store_target": "projection:koch-morse",
      "enforcement": "halt",
      "reconciliation_strategy": "codeBacked",
      "dispatch_mode": "current-state-materialize"
    },
    "Lesson": {
      "comment": "One cumulative step in a Koch course. A lesson introduces one character and names every character available for generation at that step.",
      "predicates": {
        "rdfs:label": {
          "datatype": "string",
          "multi": false,
          "required": true
        },
        "koch:lessonNumber": {
          "datatype": "integer",
          "multi": false,
          "required": true
        },
        "koch:introducesCharacter": {
          "datatype": "uri",
          "multi": false,
          "required": true
        },
        "koch:availableCharacter": {
          "datatype": "uri",
          "multi": true,
          "required": true
        },
        "koch:inCourse": {
          "datatype": "uri",
          "multi": false,
          "required": true
        }
      },
      "public_jurisdiction": "koch",
      "rdf_types": [
        "koch:Lesson"
      ],
      "subject_rule": "{graph_subject}:projection:koch-morse:lesson:{localId}",
      "source_kind": "current-state",
      "identity_kind": "logical-id",
      "store_mode": "materialize",
      "store_target": "projection:koch-morse",
      "enforcement": "halt",
      "reconciliation_strategy": "codeBacked",
      "dispatch_mode": "current-state-materialize"
    },
    "Learner": {
      "comment": "A graph-visible participant and their current practice preferences. Receive and send practice, and accumulated progress, are compatible Shrubbery faces of this same object.",
      "predicates": {
        "koch:learnerId": {
          "datatype": "string",
          "multi": false,
          "required": true
        },
        "rdfs:label": {
          "datatype": "string",
          "multi": false,
          "required": true
        },
        "koch:studiesCourse": {
          "datatype": "uri",
          "multi": false,
          "required": true
        },
        "koch:characterWpm": {
          "datatype": "integer",
          "multi": false,
          "required": true
        },
        "koch:effectiveWpm": {
          "datatype": "integer",
          "multi": false,
          "required": true
        },
        "koch:toneHz": {
          "datatype": "integer",
          "multi": false,
          "required": true
        },
        "koch:preferredRunLength": {
          "datatype": "integer",
          "multi": false,
          "required": true
        },
        "koch:showNotation": {
          "datatype": "boolean",
          "multi": false,
          "required": true
        }
      },
      "projection_faces": [
        "koch.practice.v1",
        "koch.progress.v1"
      ],
      "faces_oracle": "koch_learner_practice_progress_faces_agree",
      "public_jurisdiction": "koch",
      "rdf_types": [
        "koch:Learner"
      ],
      "subject_rule": "{graph_subject}:projection:koch-morse:learner:{localId}",
      "source_kind": "current-state",
      "identity_kind": "logical-id",
      "store_mode": "materialize",
      "store_target": "projection:koch-morse",
      "enforcement": "halt",
      "reconciliation_strategy": "codeBacked",
      "dispatch_mode": "current-state-materialize"
    },
