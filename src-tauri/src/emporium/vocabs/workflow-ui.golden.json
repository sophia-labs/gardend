        }
    },
    "comment": "Workflow Book UI vocabulary. Publication-only contract for the agent-facing choose-your-own-adventure layer over Garden workflow books: retained source-side adventure packets, page-turn decisions, named navigation routes, evidence artifacts, and authorization flags. SPARQL remains the exact substrate; wfui: terms give agents a stable conceptual/perceptual UI contract and make route decisions auditable.",
    "description": "Agent workflow-book UI terms: WorkflowAdventurePacket, PageTurnDecision, NavigationRoute, EvidenceArtifact, and AuthorizationFlag.",
    "name": "workflow-ui",
    "namespaces": {
        "dcterms": "http://purl.org/dc/terms/",
        "prov": "http://www.w3.org/ns/prov#",
        "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
        "wfui": "https://sophia-labs.com/ns/workflow-ui#",
        "xsd": "http://www.w3.org/2001/XMLSchema#"
    },
    "primary_prefix": "wfui",
    "title": "Workflow Book UI Vocabulary",
    "version": "1.0.0"
}
