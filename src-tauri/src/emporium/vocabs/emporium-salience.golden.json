{
    "classes": {
        "BlockValuation": {
            "comment": "Per-block valuation Meaningful Object. One reified BlockValuation subject per valued-or-tagged block in the :projection:salience named graph, keyed by mnemo:graphId (cell conjunct). Code-defined span (salience_rdf_materializer::salience_value_triples) — this contract is the AUTHORED mirror of that span, used to DERIVE the SHACL conformance shapes (EA-2b). DUAL-NAMESPACE: the materializer mints mirrored mnemo:/mdoc: predicates (cumulativeImportance, cumulativeValence, lastValuatedAt, tag) plus mdoc:-only and mnemo:-only ones; ALL are declared so the closed shape permits exactly the minted set. FLOAT: push_float_triple emits ^^xsd:float, so the float predicates are datatype=float (the emitter maps float->xsd:float, an EXACT-IRI match — xsd:double would NOT match, proven by the validator probe).",
            "predicates": {
                "mnemo:blockId": {
                    "datatype": "string",
                    "multi": false,
                    "required": true
                },
                "mnemo:cumulativeImportance": {
                    "datatype": "float",
                    "multi": false,
                    "required": true
                },
                "mnemo:cumulativeValence": {
                    "datatype": "float",
                    "multi": false,
                    "required": true
                },
                "mnemo:documentId": {
                    "datatype": "string",
                    "multi": false,
                    "required": true
                },
                "mnemo:graphId": {
                    "datatype": "string",
                    "multi": false,
                    "required": true
                },
                "mnemo:lastValuatedAt": {
                    "datatype": "string",
                    "multi": false,
                    "required": false
                },
                "mnemo:tag": {
                    "datatype": "string",
                    "multi": true,
                    "required": false
                },
                "mnemo:targetsBlock": {
                    "datatype": "uri",
                    "multi": false,
                    "required": true
                },
                "mnemo:valuationCount": {
                    "datatype": "integer",
                    "multi": false,
                    "required": true
                },
                "mdoc:blockRef": {
                    "datatype": "uri",
                    "multi": false,
                    "required": true
                },
                "mdoc:cumulativeImportance": {
                    "datatype": "float",
                    "multi": false,
                    "required": true
                },
                "mdoc:cumulativeValence": {
                    "datatype": "float",
                    "multi": false,
                    "required": true
                },
                "mdoc:importanceCount": {
