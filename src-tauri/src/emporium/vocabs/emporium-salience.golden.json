                },
                "mdoc:rawValenceSum": {
                    "datatype": "float",
                    "multi": false,
                    "required": true
                },
                "mdoc:tag": {
                    "datatype": "string",
                    "multi": true,
                    "required": false
                },
                "mdoc:userImportance": {
                    "datatype": "float",
                    "multi": false,
