  "raw_shacl_shapes": "@prefix sh: <http://www.w3.org/ns/shacl#> .\n@prefix ludus: <https://sophia-labs.com/ns/ludus#> .\n\nludus:SourceEditionBounds a sh:NodeShape ; sh:targetClass ludus:SourceEdition ;\n  sh:property [ sh:path ludus:sourceSha256 ; sh:pattern \"^[0-9a-f]{64}$\" ] ;\n  sh:property [ sh:path ludus:title ; sh:minLength 1 ] ;\n  sh:property [ sh:path ludus:editionLabel ; sh:minLength 1 ] ;\n  sh:property [ sh:path ludus:sourceStatus ; sh:minLength 1 ] .\n\nludus:SourceOccurrenceBounds a sh:NodeShape ; sh:targetClass ludus:SourceOccurrence ;\n  sh:property [ sh:path ludus:sourceSha256 ; sh:pattern \"^[0-9a-f]{64}$\" ] ;\n  sh:property [ sh:path ludus:passageTextSha256 ; sh:pattern \"^[0-9a-f]{64}$\" ] ;\n  sh:property [ sh:path ludus:text ; sh:minLength 1 ] ;\n  sh:property [ sh:path ludus:startByte ; sh:minInclusive 0 ] ;\n  sh:property [ sh:path ludus:endByte ; sh:minInclusive 0 ] ;\n  sh:property [ sh:path ludus:sourceReferenceJson ; sh:minLength 1 ] ;\n  sh:property [ sh:path ludus:startByte ; sh:lessThan ludus:endByte ] .\n\nludus:ConceptBounds a sh:NodeShape ; sh:targetClass ludus:Concept ;\n  sh:property [ sh:path ludus:conceptId ; sh:minLength 1 ] ;\n  sh:property [ sh:path ludus:version ; sh:minLength 1 ] ;\n  sh:property [ sh:path ludus:title ; sh:minLength 1 ] ;\n  sh:property [ sh:path ludus:explanation ; sh:minLength 1 ] ;\n  sh:property [ sh:path ludus:limits ; sh:minLength 1 ] ;\n  sh:property [ sh:path ludus:provenanceJson ; sh:minLength 1 ] .\n\nludus:EncounterBounds a sh:NodeShape ; sh:targetClass ludus:Encounter ;\n  sh:property [ sh:path ludus:encounterId ; sh:minLength 1 ] ;\n  sh:property [ sh:path ludus:version ; sh:minLength 1 ] ;\n  sh:property [ sh:path ludus:title ; sh:minLength 1 ] ;\n  sh:property [ sh:path ludus:prompt ; sh:minLength 1 ] ;\n  sh:property [ sh:path ludus:rubricVersion ; sh:minLength 1 ] ;\n  sh:property [ sh:path ludus:rubricJson ; sh:minLength 1 ] ;\n  sh:property [ sh:path ludus:assistancePolicyJson ; sh:minLength 1 ] ;\n  sh:property [ sh:path ludus:authorship ; sh:minLength 1 ] .\n\nludus:AttemptSubmittedBounds a sh:NodeShape ; sh:targetClass ludus:AttemptSubmitted ;\n  sh:property [ sh:path ludus:encounterVersion ; sh:minLength 1 ] ;\n  sh:property [ sh:path ludus:learnerId ; sh:minLength 1 ] ;\n  sh:property [ sh:path ludus:answer ; sh:minLength 1 ] ;\n  sh:property [ sh:path ludus:reasoning ; sh:minLength 1 ] ;\n  sh:property [ sh:path ludus:assistanceJson ; sh:minLength 1 ] ;\n  sh:property [ sh:path ludus:sourceSha256 ; sh:pattern \"^[0-9a-f]{64}$\" ] ;\n  sh:property [ sh:path ludus:rubricVersion ; sh:minLength 1 ] ;\n  sh:property [ sh:path ludus:documentId ; sh:minLength 1 ] ;\n  sh:property [ sh:path ludus:documentRevision ; sh:minLength 1 ] .\n\nludus:FeedbackRecordedBounds a sh:NodeShape ; sh:targetClass ludus:FeedbackRecorded ;\n  sh:property [ sh:path ludus:authorId ; sh:minLength 1 ] ;\n  sh:property [ sh:path ludus:authorKind ; sh:minLength 1 ] ;\n  sh:property [ sh:path ludus:authorVersion ; sh:minLength 1 ] ;\n  sh:property [ sh:path ludus:text ; sh:minLength 1 ] ;\n  sh:property [ sh:path ludus:basisVersion ; sh:minLength 1 ] ;\n  sh:property [ sh:path ludus:sourceSha256 ; sh:pattern \"^[0-9a-f]{64}$\" ] ;\n  sh:property [ sh:path ludus:rubricVersion ; sh:minLength 1 ] ;\n  sh:property [ sh:path ludus:documentId ; sh:minLength 1 ] ;\n  sh:property [ sh:path ludus:assistanceJson ; sh:minLength 1 ] ;\n  sh:property [ sh:path ludus:qualificationsJson ; sh:minLength 1 ] .\n"
}
