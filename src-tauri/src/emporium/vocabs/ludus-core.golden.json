        "ludus:endByte": {
          "datatype": "integer",
          "multi": false,
          "required": true
        },
        "ludus:sourceReferenceJson": {
          "datatype": "string",
          "multi": false,
          "required": true
        },
        "ludus:anchorId": {
          "datatype": "uri",
          "multi": false,
          "required": false
        },
        "ludus:containerPassageId": {
          "datatype": "uri",
          "multi": false,
          "required": false
        }
      },
      "source_kind": "current-state",
      "identity_kind": "logical-id",
      "identity_fields": [
        "localId"
      ],
      "store_mode": "materialize",
      "store_target": "projection:ludus",
      "enforcement": "halt",
      "reconciliation_strategy": "codeBacked",
      "dispatch_mode": "current-state-materialize"
    },
