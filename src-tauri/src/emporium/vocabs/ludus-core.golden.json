{
  "name": "ludus-core",
  "version": "1.0.0",
  "title": "Ludus source and learning records",
  "description": "Pinned source references, attributed concepts and encounters, and immutable source-log attempt/feedback snapshots in the learner's authorized graph.",
  "comment": "Public non-dry-run writes require active source authority for event immutability. Current-state classes remain mutable under source reconciliation. JSON string fields retain complete submitted data; their domain semantics and cross-reference fidelity require the Ludus consumer.",
  "primary_prefix": "ludus",
  "namespaces": {
    "ludus": "https://sophia-labs.com/ns/ludus#",
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "sh": "http://www.w3.org/ns/shacl#"
  },
  "write_target": "projection:ludus",
  "comanaged_forbidden": [
    "doc:",
    "mnemo:",
    "nfo:"
  ],
  "classes": {
    "SourceEdition": {
      "comment": "Versioned editorial/source current-state object. A version label or content-based localId is a consumer convention, not a server immutability guarantee.",
      "rdf_types": [
        "ludus:SourceEdition"
      ],
      "subject_rule": "{graph_subject}:projection:ludus:source-edition:{localId}",
      "predicates": {
        "ludus:sourceId": {
          "datatype": "uri",
          "multi": false,
          "required": true
        },
        "ludus:sourceSha256": {
          "datatype": "string",
          "multi": false,
          "required": true
        },
        "ludus:title": {
          "datatype": "string",
          "multi": false,
          "required": true
        },
        "ludus:editionLabel": {
          "datatype": "string",
          "multi": false,
          "required": true
        },
        "ludus:sourceStatus": {
          "datatype": "string",
          "multi": false,
          "required": true
        },
        "ludus:sourceUrl": {
          "datatype": "uri",
          "multi": false,
          "required": false
        },
        "ludus:artifactId": {
          "datatype": "string",
          "multi": false,
          "required": false
        },
        "ludus:artifactRevision": {
          "datatype": "string",
          "multi": false,
          "required": false
        }
      },
      "source_kind": "current-state",
      "identity_kind": "logical-id",
      "identity_fields": [
        "localId"
      ],
      "store_mode": "materialize",
      "store_target": "projection:ludus",
      "enforcement": "halt",
      "reconciliation_strategy": "codeBacked",
      "dispatch_mode": "current-state-materialize"
    },
    "SourceOccurrence": {
