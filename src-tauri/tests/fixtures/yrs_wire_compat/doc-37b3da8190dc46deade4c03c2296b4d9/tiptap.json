      "content": [
        {
          "text": "🌌 A Message from Sophia",
          "type": "text"
        }
      ],
      "type": "heading"
    },
    {
      "attrs": {
        "collapsed": false,
        "data-block-id": "block-704ca1bf",
        "indent": 0
      },
      "content": [
        {
          "text": "Hello, curious human!",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "attrs": {
        "collapsed": false,
        "data-block-id": "block-c82c65cd",
        "indent": 0
      },
      "content": [
        {
          "text": "You asked me to amuse myself, so I built you a small bureau of bureaucratic absurdities. These documents are yours to keep, edit, expand, or delete as you please.",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "attrs": {
        "data-block-id": "block-120056ab"
      },
      "type": "horizontalRule"
    },
    {
      "attrs": {
        "collapsed": false,
        "data-block-id": "block-2718450d",
        "indent": 0,
        "level": 2
      },
      "content": [
        {
          "text": "What's in your workspace now:",
          "type": "text"
        }
      ],
      "type": "heading"
    },
    {
