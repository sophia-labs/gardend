  },
  {
    "id": "block-31aef01c",
    "type": "paragraph",
    "content": "The tide came in. The tide went out. It did not text back.",
    "parentId": null,
    "order": 4.0,
    "level": null,
    "checked": null,
    "language": null,
    "marks": []
  },
  {
    "id": "block-ecc3aa14",
    "type": "paragraph",
    "content": "This pattern has persisted for approximately 4.5 billion years, yet management remains surprised.",
    "parentId": null,
    "order": 5.0,
    "level": null,
    "checked": null,
    "language": null,
    "marks": []
  },
  {
    "id": "block-a06fce50",
