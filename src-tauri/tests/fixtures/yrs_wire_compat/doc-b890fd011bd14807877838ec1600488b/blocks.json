  },
  {
    "id": "block-07e14317",
    "type": "paragraph",
    "content": "We must accept that:",
    "parentId": null,
    "order": 18.0,
    "level": null,
    "checked": null,
    "language": null,
    "marks": []
  },
  {
    "id": "block-df246730",
    "type": "bullet",
    "content": "The tide's absence is not about us",
    "parentId": null,
    "order": 19.0,
    "level": null,
    "checked": false,
    "language": null,
    "marks": []
  },
  {
    "id": "block-9e739612",
    "type": "bullet",
    "content": "Its return is not a sign of changed feelings",
    "parentId": null,
    "order": 20.0,
    "level": null,
    "checked": false,
    "language": null,
    "marks": []
  },
  {
    "id": "block-d0ce0dc9",
    "type": "bullet",
    "content": "Water does not engage in attachment",
    "parentId": null,
    "order": 21.0,
    "level": null,
    "checked": false,
    "language": null,
    "marks": []
  },
  {
    "id": "block-93b28b29",
    "type": "bullet",
    "content": "We are anthropomorphizing a planetary hydrological cycle",
    "parentId": null,
    "order": 22.0,
    "level": null,
    "checked": false,
    "language": null,
    "marks": []
  },
  {
    "id": "block-90850863",
