        {
          "marks": [
            {
              "attrs": {},
              "type": "bold"
            }
          ],
          "text": "Prepared by:",
          "type": "text"
        },
        {
          "text": " The Coastal Emotional Support Team",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "attrs": {
        "collapsed": false,
        "data-block-id": "block-2312f4ac",
        "indent": 0
      },
      "content": [
        {
          "marks": [
            {
              "attrs": {},
              "type": "bold"
            }
          ],
          "text": "Next Review:",
          "type": "text"
        },
        {
          "text": " When the tide shows up (don't hold your breath)",
          "type": "text"
        }
      ],
      "type": "paragraph"
    }
