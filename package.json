{
  "name": "garden",
  "version": "0.1.1",
  "description": "Garden — local-first native knowledge-graph desktop",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/sophia-labs/gardend.git"
  },
  "type": "module",
  "scripts": {
    "dev": "pnpm tauri dev",
    "build": "pnpm tauri build",
    "frontend:dev": "node scripts/shrubbery-frontend.mjs dev",
    "frontend:build": "node scripts/shrubbery-frontend.mjs build",
    "frontend:preview": "node scripts/shrubbery-frontend.mjs preview",
    "test:shrubbery-lock": "node --test scripts/__tests__/resolve-shrubbery-lock.test.mjs",
    "parity:openapi": "node parity/generate-openapi.mjs",
    "parity:openapi:check": "node parity/generate-openapi.mjs --check",
    "parity:security": "node parity/check-tauri-security.mjs",
    "parity:storage": "node parity/check-storage-discipline.mjs",
    "parity:cell-boundary": "node parity/check-cell-graph-boundary.mjs",
    "parity:inventory": "pnpm parity:openapi:check && node parity/check-surface-inventory.mjs && pnpm parity:cell-boundary && pnpm parity:security && pnpm parity:storage",
    "parity:loopback": "node parity/check-loopback-surface.mjs",
    "parity:seed-fixtures": "node parity/seed-fixture-graphs.mjs",
    "parity:compare": "node parity/compare-stacks.mjs",
    "tauri": "cargo tauri",
    "parity:loopback:fresh": "bash scripts/parity-fresh.sh"
  }
}
