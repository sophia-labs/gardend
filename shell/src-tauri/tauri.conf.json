{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sophia",
  "version": "0.1.0",
  "identifier": "com.sophia-labs.sophia",
  "build": {
    "frontendDist": "../static"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "category": "Productivity",
    "shortDescription": "Sophia",
    "longDescription": "Sophia on this Mac: your gardens, chat and Sophia Compute, in a native window.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    },
    "externalBin": [
      "binaries/gardend"
    ],
    "resources": {
      "stage/ui/": "ui/",
      "stage/services/": "services/",
      "stage/node/": "node/",
      "stage/lib/": "lib/"
    }
  }
}
