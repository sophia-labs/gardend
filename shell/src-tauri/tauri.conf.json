{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sophia",
  "version": "0.1.0",
  "identifier": "com.sophia-labs.sophia",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "category": "Productivity",
    "shortDescription": "Sophia",
    "longDescription": "A native window onto Sophia.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    },
    "externalBin": [
      "binaries/gardend"
    ]
  }
}
